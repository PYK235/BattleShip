# Copy this file to .env and fill in your local settings.
# Java does not automatically load .env; export these values as environment variables.
BATTLESHIP_DB_URL=jdbc:mysql://localhost:3306/battleship?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=Asia/Ho_Chi_Minh
BATTLESHIP_DB_USER=root
BATTLESHIP_DB_PASSWORD=YOUR_MYSQL_PASSWORD
BATTLESHIP_SERVER_HOST=localhost
BATTLESHIP_SERVER_PORT=5051
